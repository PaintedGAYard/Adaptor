{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=adaptor;Username=postgres;Password=postgres"
  },
  "Adaptor": {
    "DefaultTransactionTimeout": "00:00:30",
    "SessionIdleTimeout": "00:01:00",
    "MaxTransactionTimeout": "00:05:00",
    "BlobStreamTransactionTimeout": "24:00:00",
    "MaxBlobStreamTransactionTimeout": "72:00:00",
    "PausedTransactionTimeout": "00:05:00",
    "SessionCleanupInterval": "00:00:30"
  }
}
